    local isLegitOrbCollecting = false
    local legitOrbCoroutine = nil

    local W = 0x57
    local A = 0x41
    local S = 0x53
    local D = 0x44

    local SCAN_INTERVAL = 2
    local REACH_DISTANCE = 3
    local MOVE_INTERVAL = 0.08

    local targetOrb = nil
    local orbQueue = {}
    local knownOrbs = {}

    local lastScan = 0
    local lastMove = 0
    local lastDebug = 0

    local lastPosition = nil
    local stuckTimer = 0
    local stuckThreshold = 0.5
    local lastMoveDirection = nil
    local isStuck = false

    local function releaseMovement()
        pcall(keyrelease, W)
        pcall(keyrelease, A)
        pcall(keyrelease, S)
        pcall(keyrelease, D)
    end

    local function press(key)
        pcall(keypress, key)
    end

    local function getRoot()
        local character = game.Players.LocalPlayer.Character
        if not character then
            return nil
        end
        return character:FindFirstChild("HumanoidRootPart")
    end

    local function orbCollected(orb)
        if not orb then
            return true
        end
        if not orb.Parent then
            return true
        end
        if orb:IsA("BasePart") then
            local size = orb.Size
            if size.X <= 0.05 and size.Y <= 0.05 and size.Z <= 0.05 then
                return true
            end
        end
        return false
    end

    local function scanOrbs()
        local root = getRoot()
        if not root then
            return
        end

        local newOrbs = {}

        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("BasePart") and object.Name == "Orb" and object.Parent and not knownOrbs[object] then
                knownOrbs[object] = true
                table.insert(newOrbs, object)
            end
        end

        table.sort(newOrbs, function(a, b)
            if not a.Parent then
                return false
            end
            if not b.Parent then
                return true
            end
            local da = (a.Position - root.Position).Magnitude
            local db = (b.Position - root.Position).Magnitude
            return da < db
        end)

        for _, orb in ipairs(newOrbs) do
            table.insert(orbQueue, orb)
        end
    end

    local function getNextOrb()
        while #orbQueue > 0 do
            local orb = table.remove(orbQueue, 1)
            if orb and orb.Parent and not orbCollected(orb) then
                return orb
            end
            knownOrbs[orb] = nil
        end
        return nil
    end

    local function moveToward(targetPosition, root)
        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local offset = targetPosition - root.Position
        local targetDirection = Vector3.new(offset.X, 0, offset.Z)

        if targetDirection.Magnitude < 0.1 then
            releaseMovement()
            return
        end

        targetDirection = targetDirection.Unit

        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        forward = Vector3.new(forward.X, 0, forward.Z)
        right = Vector3.new(right.X, 0, right.Z)

        if forward.Magnitude > 0 then
            forward = forward.Unit
        end
        if right.Magnitude > 0 then
            right = right.Unit
        end

        local forwardAmount = targetDirection:Dot(forward)
        local rightAmount = targetDirection:Dot(right)

        releaseMovement()

        if forwardAmount > 0.25 then
            press(W)
            lastMoveDirection = "forward"
        elseif forwardAmount < -0.25 then
            press(S)
            lastMoveDirection = "backward"
        end

        if rightAmount > 0.25 then
            press(D)
            lastMoveDirection = "right"
        elseif rightAmount < -0.25 then
            press(A)
            lastMoveDirection = "left"
        end
    end

    local function checkStuck(root)
        if not root then
            return false
        end
        
        local currentPos = root.Position
        
        if lastPosition then
            local distance = (currentPos - lastPosition).Magnitude
            
            if distance < 0.1 then
                stuckTimer = stuckTimer + 0.02
            else
                stuckTimer = 0
                isStuck = false
            end
            
            if stuckTimer >= stuckThreshold then
                if not isStuck then
                    isStuck = true
                end
                return true
            end
        end
        
        lastPosition = currentPos
        return false
    end

    local function moveForwardLastDirection()
        releaseMovement()
        
        if lastMoveDirection == "forward" then
            press(W)
        elseif lastMoveDirection == "backward" then
            press(S)
        elseif lastMoveDirection == "right" then
            press(D)
        elseif lastMoveDirection == "left" then
            press(A)
        else
            press(W)
        end
        
        task.wait(0.15)
        releaseMovement()
        
        stuckTimer = 0
        isStuck = false
        lastPosition = nil
    end

    orbSec:Toggle("legitOrbCollect", "Legit Orb Collecting", false, function(enabled)
        isLegitOrbCollecting = enabled

        if enabled then
            if legitOrbCoroutine then
                return
            end

            legitOrbCoroutine = task.spawn(function()
                while isLegitOrbCollecting do
                    local root = getRoot()

                    if not root then
                        releaseMovement()
                        targetOrb = nil
                        orbQueue = {}
                        knownOrbs = {}
                        stuckTimer = 0
                        isStuck = false
                        lastPosition = nil
                        task.wait(0.5)
                        continue
                    end

                    if checkStuck(root) then
                        moveForwardLastDirection()
                        task.wait(0.05)
                        continue
                    end

                    if os.clock() - lastScan >= SCAN_INTERVAL then
                        lastScan = os.clock()
                        scanOrbs()
                    end

                    if not targetOrb then
                        targetOrb = getNextOrb()
                        if targetOrb then
                            stuckTimer = 0
                            isStuck = false
                            lastPosition = nil
                        end
                    end

                    if not targetOrb then
                        releaseMovement()
                        task.wait(0.2)
                        continue
                    end

                    if orbCollected(targetOrb) then
                        local reallyCollected = false
                        local checkCount = 0
                        
                        while checkCount < 3 and not reallyCollected do
                            task.wait(0.05)
                            checkCount = checkCount + 1
                            
                            if not targetOrb or not targetOrb.Parent or orbCollected(targetOrb) then
                                reallyCollected = true
                                break
                            end
                        end
                        
                        if not reallyCollected and targetOrb and targetOrb.Parent then
                            moveForwardLastDirection()
                            
                            task.wait(0.05)
                            if not targetOrb or not targetOrb.Parent or orbCollected(targetOrb) then
                                reallyCollected = true
                            end
                        end

                        if targetOrb then
                            knownOrbs[targetOrb] = nil
                        end
                        
                        if reallyCollected then
                            targetOrb = nil
                            stuckTimer = 0
                            isStuck = false
                            lastPosition = nil
                        else
                            local oldOrb = targetOrb
                            targetOrb = nil
                            if oldOrb and oldOrb.Parent then
                                table.insert(orbQueue, 1, oldOrb)
                            end
                            stuckTimer = 0
                            isStuck = false
                            lastPosition = nil
                        end

                        releaseMovement()
                        task.wait(0.05)
                        continue
                    end

                    local distance = (targetOrb.Position - root.Position).Magnitude

                    if distance <= REACH_DISTANCE then
                        releaseMovement()
                        task.wait(0.05)
                        continue
                    end

                    if os.clock() - lastMove >= MOVE_INTERVAL then
                        lastMove = os.clock()
                        moveToward(targetOrb.Position, root)
                    end

                    task.wait(0.02)
                end

                releaseMovement()
                targetOrb = nil
                orbQueue = {}
                knownOrbs = {}
                lastPosition = nil
                stuckTimer = 0
                isStuck = false
                legitOrbCoroutine = nil
            end)
        else
            releaseMovement()
            targetOrb = nil
            orbQueue = {}
            knownOrbs = {}
            lastPosition = nil
            stuckTimer = 0
            isStuck = false
            if legitOrbCoroutine then
                task.cancel(legitOrbCoroutine)
                legitOrbCoroutine = nil
            end
        end
    end)

